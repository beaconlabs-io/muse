# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/.wrangler/
/out/

# build-time generated OG images (scripts/generate-og-images.tsx)
/public/og/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# env files (can opt-in for committing if needed)
# The OpenNext build bakes every one of these into the Worker script, so keep
# server secrets out of them entirely — see docs/setup.md.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# wrangler local secrets
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.serena
.playwright-mcp/
.claude/plans
.claude/project-output
.claude/settings.local.json
.claude/worktrees
.codex/config.toml

# Vector store for RAG evidence search
vector.*

# Leftovers from the removed Mastra AI layer. Nothing regenerates these — the
# layer now lives in the muse-backend service — but existing checkouts still
# have the LibSQL database on disk (~950MB) and it must never be committed.
# Delete the files locally, then these rules can go.
.mastra
mastra.db*
