{
  "name": "muse",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run generate:og && next build",
    "generate:og": "bun run scripts/generate-og-images.tsx",
    "start": "next start",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:worker": "NEXT_UNOPTIMIZED_IMAGES=true opennextjs-cloudflare build",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy:staging": "bun run build:worker && opennextjs-cloudflare deploy -e staging",
    "deploy:production": "bun run build:worker && opennextjs-cloudflare deploy -e production",
    "clean": "rm -rf .next .open-next node_modules && bun install",
    "prepare": "husky",
    "docker:build": "docker compose --env-file .env.local build",
    "docker:up": "docker compose --env-file .env.local up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "upgrade:next": "bunx @next/codemod@canary upgrade latest"
  },
  "dependencies": {
    "@beaconlabs-io/evidence": "^1.1.4",
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.9.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@next/mdx": "16.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "graphql-request": "^7.4.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.562.0",
    "multiformats": "^13.4.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "onborda": "^1.2.5",
    "radix-ui": "1.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-toc": "^3.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "path-to-regexp": "^6.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
