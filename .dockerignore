# Dependencies
node_modules
.pnp
.pnp.*
.yarn/*

# Build outputs
.next
.open-next
.wrangler
out
build
dist

# Git
.git
.gitignore
.gitmodules

# Environment files
# `next build` reads every .env* file in the context and inlines what it finds,
# so keep all of them out — build-time values come from build args only.
.env*

# IDE / Editor
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development tools
.serena
.mastra
.claude
.husky
.agents
.codex
.playwright
.playwright-mcp

# Leftover LibSQL database from the removed Mastra layer (~880MB on checkouts
# that predate 832bee8). Nothing regenerates it; without this line the whole
# thing rides into the build context.
mastra.db*

# Misc
*.md
!README.md
LICENSE
FUNDING.json
*.tsbuildinfo

# Test / Coverage
coverage
*.test.*
*.spec.*

# Vercel
.vercel
